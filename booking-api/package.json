{
  "name": "mederinav-booking",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --local-upstream localhost:8787",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply mederinav-bookings --local",
    "db:migrate:remote": "wrangler d1 migrations apply mederinav-bookings --remote"
  },
  "devDependencies": {
    "wrangler": "^4.151.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
