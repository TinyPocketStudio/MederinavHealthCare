# Copy this file to .dev.vars for local testing (`npm run dev`).
# .dev.vars is ignored by Git – put local test keys there, never in wrangler.toml.
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Who gets the "Ny bokning" email locally.
CLINIC_NOTIFY_EMAIL="clinic@example.com"

# Leave empty to only print emails in the terminal instead of sending them.
# To really send test emails, paste a Brevo API key here (never commit it).
BREVO_API_KEY=""

# Local testing of the staff page (/admin/) without Cloudflare Access.
# Only works on localhost – it has no effect on the live site.
ADMIN_DEV_EMAIL="christian@mederinavhealthcare.se"

# Bot check (Turnstile). Cloudflare's official test secrets: 1x0000000000000000000000000000000AA
# always passes, 2x0000000000000000000000000000000AA always fails. Leave out = no bot check.
TURNSTILE_SECRET="1x0000000000000000000000000000000AA"
